<Window x:Class="Akki_ARIA_Importer_MG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AKKI | DICOM batch importer" Width="800" Height="680" MinWidth="640" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <Menu DockPanel.Dock="Top" Background="Transparent" Margin="0,0,0,8">
            <MenuItem Header="_File"><MenuItem Header="_Close" Click="Close_Click"/></MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="_Disclaimer" Click="Disclaimer_Click"/><MenuItem Header="_About" Click="AboutMe_Click"/></MenuItem>
        </Menu>
        <StackPanel DockPanel.Dock="Top" Name="actions">
            <GroupBox Header="Source folder"><StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="SetInputFolderButton_Click"/>
                    <TextBox Name="pathInputTextBlock" IsReadOnly="True" Margin="0,0,8,0"/></DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Name="previewButton" Content="Preview files" Click="Preview_Click"/>
                    <CheckBox Name="subDirCheckBox" VerticalAlignment="Center" Content="Include subdirectories" IsChecked="True"/>
                </StackPanel>
            </StackPanel></GroupBox>
            <GroupBox Header="DICOM connection"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><Label Target="{Binding ElementName=DaemonTitleTextBox}" Content="Receiver AE"/><TextBox Name="DaemonTitleTextBox" MaxLength="16"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0"><Label Target="{Binding ElementName=DaemonIpTextBox}" Content="Host or IP"/><TextBox Name="DaemonIpTextBox"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0"><Label Target="{Binding ElementName=DaemonPortTextBox}" Content="Port"/><TextBox Name="DaemonPortTextBox"/></StackPanel>
                <StackPanel Grid.Column="3"><Label Target="{Binding ElementName=AEtitleTextBox}" Content="Calling AE"/><TextBox Name="AEtitleTextBox" MaxLength="16"/></StackPanel>
            </Grid></GroupBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Name="checkPatients" Content="Check patient IDs" Click="CheckPatients_Click"/>
                <Button Name="echoButton" Content="Test connection" Click="Echo_Click"/>
                <Button Name="runButton" Content="Send DICOM files" Background="#175477" Foreground="White" Click="Import_Click"/>
            </StackPanel>
            <CheckBox Name="existingOnly" Content="Send only IDs confirmed by the receiver" Margin="0,0,0,10"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"><ProgressBar Name="progressBar" Height="8" Maximum="100"/>
            <TextBlock Name="ProgressTextBlock" Margin="0,6,0,0" TextWrapping="Wrap" Text="Choose a source folder to begin."/></StackPanel>
        <TabControl><TabItem Name="activityTab" Header="Activity"><TextBox Name="logTextBox" IsReadOnly="True" TextWrapping="Wrap"
            FontFamily="Consolas" VerticalScrollBarVisibility="Auto" BorderThickness="0"/></TabItem>
            <TabItem Name="patientTab" Header="Patient ID check"><DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="6"
                    Text="No visible match: if the patient is new and creation is enabled, the incoming ID is the candidate. If creation is forbidden, expect rejection. The daemon controls the final ID."/>
                <DataGrid Name="patientRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Incoming ID" Binding="{Binding InputID}" Width="*"/>
                        <DataGridTextColumn Header="Issuer" Binding="{Binding Issuer}" Width="*"/>
                        <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="Auto"/>
                        <DataGridTextColumn Header="Receiver result" Binding="{Binding Result}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel></TabItem></TabControl>
    </DockPanel>
</Window>
